# =============================================================
# MTA ILLEGAL BİRLİK DISCORD BOTU - ORTAM DEĞİŞKENLERİ
# =============================================================

# Discord Geliştirici Portalı (https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id_here
DISCORD_GUILD_ID=your_discord_server_id_here

# Kalıcı Veritabanı: Sıfır harici veritabanı bağımlılığı (Otomatik JSON Disk Veritabanı 'data/birlik_database.json')
# Harici MongoDB veya SQL gerektirmez, 7/24 kesintisiz çalışır.

# Log Seviyesi (debug, info, warn, error)
LOG_LEVEL=info

# Node Ortamı
NODE_ENV=production
